# ============================================================
# AI-Platform 环境变量配置示例
# 复制为 .env 后按需修改
# 来源: deployment / runtime 全部从此处读取
# ============================================================

# --- 服务端 ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
APP_HOME=/opt/ai-platform
APP_NAME=ai-platform

# --- 数据库 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_platform
DB_USER=aiplatform
DB_PWD=ChangeMeStrong!2026
DB_ROOT_PASSWORD=root

# --- 文件目录 ---
UPLOAD_PATH=/data/upload
HNSW_PATH=/data/hnsw
LOG_PATH=/data/logs
BACKUP_PATH=/data/backup

# --- JWT ---
# 至少 32 字节,推荐 64 字节随机串
# 生成方式: openssl rand -base64 48
JWT_SECRET=ai-platform-jwt-secret-key-please-change-in-production-2026
JWT_ISSUER=ai-platform
JWT_ACCESS_TTL_SECONDS=7200
JWT_REFRESH_TTL_SECONDS=2592000

# --- 进程 / JVM ---
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Dfile.encoding=UTF-8

# --- 日志 ---
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# --- 压测(可选,压测脚本可读取) ---
JMETER_BASE_URL=http://127.0.0.1:8080
JMETER_THREADS=50
JMETER_RAMP=10
JMETER_LOOPS=100