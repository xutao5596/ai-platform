# ====================================================================
# AI-Platform Frontend Dockerfile (Nginx)
# Build: docker build -t ai-platform-frontend:1.0.0 -f Dockerfile.frontend ../..
# ====================================================================

# Stage 1: Build
FROM node:24-alpine AS builder

WORKDIR /build

# Copy package files
COPY ai-frontend/package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy source
COPY ai-frontend/ ./

# Build
RUN npm run build

# Stage 2: Runtime (Nginx)
FROM nginx:1.27-alpine

LABEL maintainer="AI Platform Team <team@ai-platform.com>"
LABEL description="AI-Platform Frontend"

# Copy built files
COPY --from=builder /build/dist /usr/share/nginx/html

# Copy nginx config
COPY ai-deploy/nginx/conf.d/ai-platform.conf /etc/nginx/conf.d/default.conf

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD wget -q --spider http://localhost/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
